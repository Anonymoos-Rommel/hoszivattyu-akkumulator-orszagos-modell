  "original_requirement": "Időjárás/ár/terhelés/ellátás/timing együttes, dátumozott történeti ablakok; HU/EU kapcsolódás. Külön statisztikai bizonytalanság, strukturális ismerethiány és POL stressz.",
  "original_field_mapping": [
    {
      "criterion": "Weather",
      "original_source_evidence": "Exact accepted Budapest44527 preceding-hour temperature handoff, SHA a213df5a30b30360443681f81977c111145795d23f5c2a05e4eeeec6738c3f39; 8,759 historical endpoints plus the qualified recent endpoint.",
      "consumer_binding": "modules/B19/historical_joint_stress.py::_weather/_weather_rows/_joined_hours; historical_joint_market.py::calculate_reference/_summarize hourly_observations.temperature_c and weather_source_id; each window.weather_station_id/weather_source_hours",
      "independent_result": "All 8,760 station temperatures and their physical hours/source IDs match the preimplementation oracle. Every window retains station44527 and the actual historical/recent source-hour counts; no national weighting or Austrian weather inference.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    },
    {
      "criterion": "Price",
      "original_source_evidence": "Accepted V1-057 HU publisher-hourly EUR/MWh plus independently qualified AT publisher-hourly field. Exact raw hashes and separate retrieval as-of timestamps are retained.",
      "consumer_binding": "modules/B19/austrian_price_reference.py::read_austrian_reference/_configuration/_parse_csv/_witnesses/_reconcile; modules/B04/wholesale_reference.py::read_wholesale_reference; historical_joint_market.py::_price_rows/hourly_observations/market_eur_per_mwh",
      "independent_result": "All HU and AT hourly prices, exact lexemes, local/source labels, physical endpoints and negative/zero values match preserved originals and independent oracle. All 8,689 same-window market means/ranges/spreads agree. The AT source identity is distinct; both retrospective retrieval timestamps and unknown auction/per-record vintages are exposed.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    },
    {
      "criterion": "Load",
      "original_source_evidence": "Accepted native Actual Total Load PT15M source, DER/E2. Exact source-validation primitive and all source/handoff pins replayed to exhaustion.",
      "consumer_binding": "modules/B08/historical_source_balance.py::iter_historical_source_balance; historical_joint_stress.py::_joined_hours; historical_joint_market.py::_summarize hourly_observations.energy_mwh and window.energy_mwh/mean_power_mw",
      "independent_result": "Every hourly load and each complete-window energy/mean matches exact quarter-hour source integration in the prior independent oracle. Actual load retains DER/E2 and Q-B08-001; no forecast substitution or new E1 requirement.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    },
    {
      "criterion": "Supply",
      "original_source_evidence": "Accepted domestic source generation, signed operational recovery, positive injection and source withdrawal. Native signed generation equals injection minus withdrawal.",
      "consumer_binding": "modules/B08/historical_source_balance.py::iter_historical_source_balance; historical_joint_market.py::_summarize plus physical_source_evidence/physical_validation_debt/supply_interpretation",
      "independent_result": "Every injection, withdrawal, signed-generation and source-reference residual hour/window agrees exactly. Both accounting identities and annual quantities hold; Q-B09-001/source estimates remain explicit. Supply is the named domestic generation reference; residual is not imports, adequacy, capacity or complete physical balance.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    },
    {
      "criterion": "Timing and dated historical windows",
      "original_source_evidence": "Complete half-open physical UTC2025 support and explicit integer H. Source-start mapping is corroborated by epochs; source DST end labels are retained separately.",
      "consumer_binding": "historical_joint_market.py::calculate_reference/_price_rows/_summarize; historical_joint_stress.py::_duration/_joined_hours; austrian_price_reference.py::_parse_csv/_witnesses; tools/materialize_b19_joint_market.py::main/materialize",
      "independent_result": "Explicit utc2025 and integer H are mandatory. All 8,760 hours and 8,689 complete non-wrapping H72 windows agree; H72 remains a caller example. Epoch/source-label and DST behavior retain physical starts/derived ends. Independent adverse checks reject incompatible domains, durations, shifted endpoints and late post-final-yield source failures before output.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    },
    {
      "criterion": "Joint co-occurrence",
      "original_source_evidence": "Private independent oracle enumerates all 8,689 complete H72 windows from 8,760 joined hours and 35,040 source grid quarters.",
      "consumer_binding": "historical_joint_market.py::_summarize windows/criteria/descriptive_same_domain_ranks; _coverage/_intersection and selector_temporal_overlap",
      "independent_result": "Every complete observed vector remains on its own actual dated window. All five selectors, exact ties, 78,201 descriptive rank records, 26,067 price ranges and signed spreads match the prior oracle. Independent hour-set tests verify coverage-union intersections for all tied selections; these are not pairwise event-overlap totals. No synthetic all-maxima event or risk score.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    },
    {
      "criterion": "HU/EU connection",
      "original_source_evidence": "Austria is a distinct EU bidding-zone price field in the exact official guide pp47–48, configuration module8004170/data_id4170 and original response headers. Every padded AT hourly label and physical interval matches HU.",
      "consumer_binding": "austrian_price_reference.py::_configuration/read_austrian_reference; registry/b19_joint_market_reference_manifest.json::at; historical_joint_market.py::regional_interpretation/retrieval_vintage_relation and market_eur_per_mwh.HU/AT/HU_MINUS_AT",
      "independent_result": "The official separate AT field supplies one named EU bidding-zone market comparison, exactly aligned with HU UTC intervals. Distinct source IDs and non-atomic retrieval vintages are retained. No physical flow/support, congestion causality or EU-wide representation is inferred.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    },
    {
      "criterion": "Statistical uncertainty",
      "original_source_evidence": "Exact finite-domain descriptive ranks and ties can be computed. Overlapping windows are dependent; original source errors and future occurrence distributions are not estimated here.",
      "consumer_binding": "registry/b19_joint_market_reference_manifest.json::uncertainty.statistical; historical_joint_market.py::uncertainty/probabilities/result.rank_meaning",
      "independent_result": "Machine output explicitly separates finite-domain descriptive ranks/ties from unestimated future probabilities or return periods. Overlapping windows remain dependent. Null probability and stated absence of stochastic confidence estimation do not imply zero uncertainty.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    },
    {
      "criterion": "Structural unknowns",
      "original_source_evidence": "Station/zone mismatch, source estimates, separate retrieval vintages and absent per-record revisions, source-cent quantization, one-year support, October resolution change and missing compatible exchange/storage observations.",
      "consumer_binding": "registry/b19_joint_market_reference_manifest.json::uncertainty.structural/excluded_claims; historical_joint_market.py::uncertainty/physical_validation_debt/spatial_boundary/price evidence/reconciliation",
      "independent_result": "Machine output exposes station-zone scope, E2/Q source accounting debt, separate price snapshots/unobserved revisions, shared publisher lineage, cent quantization and unknown tie rounding, one-year/native-resolution limits and missing exchange/storage accounting. No invented independent distributions or generic uncertainty factor.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    },
    {
      "criterion": "POL stress separated",
      "original_source_evidence": "No owner risk tolerance, adopted shock, default operating duration or programme intervention was supplied by this historical source handoff.",
      "consumer_binding": "registry/b19_joint_market_reference_manifest.json::uncertainty.POL/window_hours_default/policy_defaults_selected; historical_joint_market.py::window_definition_status/policy_defaults_selected; mandatory window_hours parameter",
      "independent_result": "No adopted shock, threshold, risk tolerance or default horizon is supplied. Caller H is explicitly analysis choice, while future owner POL/SCN scenarios remain separate. No fabricated policy stress and no new D02 owner-choice gate are required to complete this historical D01 handoff.",
      "verdict": "SATISFIED_AT_EXPLICIT_HISTORICAL_REFERENCE_SCOPE"
    }
  ],
