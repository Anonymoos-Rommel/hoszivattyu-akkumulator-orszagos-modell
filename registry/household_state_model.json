{
  "schema_version": "1.0.0",
  "status": "CONTRACTED_SKELETON",
  "source_method_baseline": [
    "Hoszivattyu_akkumulator_program_Codex_kutatasi_prompt_V1.2.docx",
    "Hoszivattyu_akkumulator_program_javaslat_V1.1_munkapeldany.docx"
  ],
  "unknown_policy": "Missing evidence is Q and cannot be promoted to a satisfied gate or zero.",
  "states": [
    {
      "state_id": "S0",
      "name": "BASELINE_AUDITED",
      "entry_requirements": ["baseline_record", "eligibility_scope", "known_gaps"],
      "exit_gate": "audit_complete"
    },
    {
      "state_id": "S1",
      "name": "DEMAND_REDUCED",
      "entry_requirements": ["S0"],
      "exit_gate": "demand_reduction_measured_or_not_required"
    },
    {
      "state_id": "S2",
      "name": "TECHNICALLY_READY",
      "entry_requirements": ["S1", "emitter_or_temperature_evidence", "hydraulic_electrical_permit_readiness"],
      "exit_gate": "technical_readiness_complete"
    },
    {
      "state_id": "S3",
      "name": "HEAT_PUMP_ACTIVE",
      "entry_requirements": ["S2", "commissioning_and_measurement"],
      "exit_gate": "heat_pump_operational_and_qa_complete"
    },
    {
      "state_id": "S4",
      "name": "FLEX_READY",
      "entry_requirements": ["S3", "legal_metering_tariff_and_control_evidence"],
      "exit_gate": "flexibility_ready"
    },
    {
      "state_id": "S5",
      "name": "TARGET_STATE",
      "entry_requirements": ["S4", "lifecycle_guarantee_and_ex_post_measurement"],
      "exit_gate": "target_state_verified"
    }
  ],
  "transition_invariants": [
    "Transitions are monotone S0 -> S1 -> S2 -> S3 -> S4 -> S5 unless blocked.",
    "A skipped state requires evidence that its exit gate is already satisfied.",
    "Existing heat-pump presence does not prove S2 or S3 readiness.",
    "Every transition has evidence references, date, owner, and next gate."
  ],
  "household_record_schema": {
    "required": [
      "household_id",
      "archetype_id",
      "region_id",
      "truth_context",
      "current_state",
      "evidence_refs",
      "state_as_of",
      "owner",
      "next_gate",
      "blocked_reason",
      "eligibility_status",
      "eligibility_evidence_status"
    ],
    "optional": ["transition_evidence"],
    "evidence_statuses": ["OBS", "DER", "ASS", "SCN", "POL", "Q"],
    "truth_contexts": ["REAL", "SCN"],
    "eligibility_statuses": ["ELIGIBLE", "BLOCKED", "Q"],
    "unknown_policy": "Missing evidence is Q; no flag, consumption, age, tariff, or archetype estimate can promote a state."
  },
  "transition_gate_semantics": "Each transition requires the source state's exit_gate and the target state's exit_gate. Candidate required_gate resolves the target_completion_gate; it is not a second gate authority.",
  "transition_contract": [
    {
      "transition_id": "S0_TO_S1",
      "from_state": "S0",
      "to_state": "S1",
      "source_exit_gate": "audit_complete",
      "target_completion_gate": "demand_reduction_measured_or_not_required",
      "required_gates": ["audit_complete", "demand_reduction_measured_or_not_required"],
      "required_evidence_class": ["OBS", "DER"],
      "allowed_completion_status": ["OBS", "DER"],
      "completion_evidence_required": true,
      "skip_requires_explicit_satisfied_gate": true,
      "fail_closed_reason": "No phase-linked demand-reduction evidence."
    },
    {
      "transition_id": "S1_TO_S2",
      "from_state": "S1",
      "to_state": "S2",
      "source_exit_gate": "demand_reduction_measured_or_not_required",
      "target_completion_gate": "technical_readiness_complete",
      "required_gates": ["demand_reduction_measured_or_not_required", "technical_readiness_complete"],
      "required_evidence_class": ["OBS", "DER"],
      "allowed_completion_status": ["OBS", "DER"],
      "completion_evidence_required": true,
      "skip_requires_explicit_satisfied_gate": true,
      "fail_closed_reason": "Emitter, hydraulic, electrical, or permit readiness evidence is missing."
    },
    {
      "transition_id": "S2_TO_S3",
      "from_state": "S2",
      "to_state": "S3",
      "source_exit_gate": "technical_readiness_complete",
      "target_completion_gate": "heat_pump_operational_and_qa_complete",
      "required_gates": ["technical_readiness_complete", "heat_pump_operational_and_qa_complete"],
      "required_evidence_class": ["OBS", "DER"],
      "allowed_completion_status": ["OBS", "DER"],
      "completion_evidence_required": true,
      "skip_requires_explicit_satisfied_gate": true,
      "fail_closed_reason": "Commissioning, QA, and measured heat-pump operation evidence is missing."
    },
    {
      "transition_id": "S3_TO_S4",
      "from_state": "S3",
      "to_state": "S4",
      "source_exit_gate": "heat_pump_operational_and_qa_complete",
      "target_completion_gate": "flexibility_ready",
      "required_gates": ["heat_pump_operational_and_qa_complete", "flexibility_ready"],
      "required_evidence_class": ["OBS", "DER"],
      "allowed_completion_status": ["OBS", "DER"],
      "completion_evidence_required": true,
      "skip_requires_explicit_satisfied_gate": true,
      "fail_closed_reason": "Metering, tariff, legal, and control evidence is missing."
    },
    {
      "transition_id": "S4_TO_S5",
      "from_state": "S4",
      "to_state": "S5",
      "source_exit_gate": "flexibility_ready",
      "target_completion_gate": "target_state_verified",
      "required_gates": ["flexibility_ready", "target_state_verified"],
      "required_evidence_class": ["OBS", "DER"],
      "allowed_completion_status": ["OBS", "DER"],
      "completion_evidence_required": true,
      "skip_requires_explicit_satisfied_gate": true,
      "fail_closed_reason": "Lifecycle guarantee, QA, and ex-post measurement evidence is missing."
    }
  ],
  "portfolio_contract": {
    "components": [
      "SOCIAL_NEED",
      "ENERGY_WASTE",
      "HOUSEHOLD_GAIN",
      "PUBLIC_EFFICIENCY",
      "FISCAL_EFFECT",
      "SYSTEM_VALUE",
      "ENV_HEALTH",
      "READINESS",
      "REGIONAL_EQUITY"
    ],
    "usable_numeric_statuses": ["OBS", "DER", "SCN", "POL"],
    "policy_parameter_statuses": ["POL", "SCN"],
    "missing_value_policy": "FAIL_CLOSED",
    "methods": ["MCDA", "CONSTRAINED_CAPACITY", "LEXICOGRAPHIC"],
    "tie_break_fields": ["household_id", "intervention_id"]
  },
  "capacity_constraint_contract": {
    "constraints": [
      "public_money",
      "household_cashflow_floor",
      "installer_FTE",
      "supplier_capacity",
      "permitting_capacity",
      "grid_headroom",
      "regional_minimum",
      "debt_headroom"
    ],
    "missing_value_policy": "Q_UNAVAILABLE"
  }
}
